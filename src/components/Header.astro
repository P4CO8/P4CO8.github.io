---
import { SITE_TITLE } from '../consts';
---

<header transition:persist transition:animate="none">
	<nav>
		<h2>
			<a href="/">{SITE_TITLE}</a>
		</h2>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1.5rem;
		background: var(--header-bg);
		backdrop-filter: var(--header-backdrop);
		border-bottom: 1px solid var(--header-border);
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
		position: sticky;
		top: 0;
		z-index: 100;
	}

	nav {
		max-width: 1200px;
		margin: 0 auto;
		min-height: 88px;
		display: flex;
		align-items: center;
	}

	h2 {
		margin: 0;
		font-size: 1.25rem;
	}

	h2 a {
		text-decoration: none;
		color: rgb(var(--black));
		font-weight: 700;
		transition: color 0.18s ease;
	}

	h2 a:hover {
		color: var(--accent);
	}

	@media (max-width: 720px) {
		header {
			padding: 0 1rem;
		}

		nav {
			min-height: 72px;
		}

		h2 {
			font-size: 1.1rem;
		}
	}
</style>