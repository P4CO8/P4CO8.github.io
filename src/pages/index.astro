---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { Image } from 'astro:assets';
import AvatarImage from '../assets/avatar.png';
import defaultHero from '../assets/hero-image-holder.jpg';
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>

	<!-- PRESENTACIÓN PRINCIPAL -->
	<div class="hero">
		<Image
			src={AvatarImage}
			alt={SITE_AUTHOR}
			width={400}
			height={400}
			class="avatar"
		/>

		<h1>{SITE_AUTHOR}</h1>
		<p>{SITE_DESCRIPTION}</p>
	</div>

	<!-- ÚNICO MÓDULO: VIDEO DE PRESENTACIÓN -->
	<section class="video-section">

		<button
			class="video-card"
			id="open-video"
			type="button"
			aria-label="Abrir video de presentación"
		>
			<div class="video-banner">
				<Image
					src={defaultHero}
					alt=""
					width={1440}
					format="webp"
					quality={80}
					class="video-banner-img"
				/>

				<div class="play-icon">
					▶
				</div>
			</div>

			<div class="video-info">
				<span class="video-badge">Presentación</span>

				<h2>Video de presentación</h2>

				<p>
					Haz clic aquí para conocer un poco más sobre mí.
				</p>
			</div>
		</button>

	</section>

	<!-- VENTANA EMERGENTE DEL VIDEO -->
	<div
		class="video-modal"
		id="video-modal"
		aria-hidden="true"
	>
		<div class="video-backdrop" id="video-backdrop"></div>

		<div class="video-modal-content">

			<button
				class="close-video"
				id="close-video"
				type="button"
				aria-label="Cerrar video"
			>
				×
			</button>

			<h2>Video de presentación</h2>

			<div class="video-container">
				<video
					id="presentation-video"
					controls
					preload="metadata"
				>
					<source
						src="/video-presentacion.mp4"
						type="video/mp4"
					/>

					Tu navegador no puede reproducir este video.
				</video>
			</div>

		</div>
	</div>

</BaseLayout>


<style>

	/* =========================
	   PRESENTACIÓN
	   ========================= */

	.hero {
		text-align: center;
		padding: 2.5rem 0 3rem;
	}

	.avatar {
		width: 200px;
		height: 200px;
		border-radius: 25%;
		margin-bottom: 1rem;
	}

	.hero h1 {
		margin: 0.4rem 0;
		font-size: 3rem;
	}

	.hero p {
		margin: 0.5rem auto;
		font-size: 1.15rem;
		color: rgb(var(--gray));
		max-width: 650px;
	}


	/* =========================
	   TARJETA DEL VIDEO
	   ========================= */

	.video-section {
		max-width: 870px;
		margin: 0 auto 4rem;
	}

	.video-card {
		width: 100%;
		display: flex;
		flex-direction: column;
		padding: 0;
		border-radius: 16px;
		overflow: hidden;

		background: rgba(var(--gray-light), 0.35);
		border: 1px solid rgba(var(--gray-light), 0.6);

		color: inherit;
		text-align: left;
		font: inherit;
		cursor: pointer;

		transition:
			transform 0.25s ease,
			box-shadow 0.25s ease;
	}

	.video-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--box-shadow);
	}


	/* Imagen superior */

	.video-banner {
		height: 280px;
		position: relative;
		overflow: hidden;
	}

	.video-banner-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;

		transition: transform 0.4s ease;
	}

	.video-card:hover .video-banner-img {
		transform: scale(1.04);
	}


	/* Botón ▶ */

	.play-icon {
		position: absolute;
		left: 50%;
		top: 50%;

		transform: translate(-50%, -50%);

		width: 80px;
		height: 80px;

		display: flex;
		align-items: center;
		justify-content: center;

		padding-left: 5px;

		border-radius: 50%;

		background: rgba(0, 0, 0, 0.65);
		color: white;

		font-size: 2rem;

		backdrop-filter: blur(8px);

		transition:
			transform 0.25s ease,
			background 0.25s ease;
	}

	.video-card:hover .play-icon {
		transform: translate(-50%, -50%) scale(1.08);
		background: var(--accent);
	}


	/* Información de la tarjeta */

	.video-info {
		padding: 1.5rem;
		background: var(--bg);
	}

	.video-badge {
		display: inline-block;

		font-size: 0.75rem;
		font-weight: 700;

		padding: 0.25rem 0.65rem;

		border-radius: 6px;

		background: var(--pinned-badge-bg);
		color: var(--pinned-badge-fg);

		margin-bottom: 0.7rem;
	}

	.video-info h2 {
		margin: 0 0 0.4rem;
		font-size: 1.5rem;
		color: rgb(var(--black));
	}

	.video-info p {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.95rem;
	}


	/* =========================
	   MODAL DEL VIDEO
	   ========================= */

	.video-modal {
		position: fixed;
		inset: 0;

		z-index: 9999;

		display: flex;
		align-items: center;
		justify-content: center;

		padding: 1.5rem;

		visibility: hidden;
		opacity: 0;

		transition:
			opacity 0.25s ease,
			visibility 0.25s ease;
	}

	.video-modal.open {
		visibility: visible;
		opacity: 1;
	}

	.video-backdrop {
		position: absolute;
		inset: 0;

		background: rgba(0, 0, 0, 0.75);

		backdrop-filter: blur(5px);
	}

	.video-modal-content {
		position: relative;
		z-index: 1;

		width: min(950px, 95vw);

		background: var(--bg);

		border-radius: 18px;

		padding: 1.5rem;

		box-shadow: 0 25px 80px rgba(0, 0, 0, 0.5);

		transform: scale(0.95);

		transition: transform 0.25s ease;
	}

	.video-modal.open .video-modal-content {
		transform: scale(1);
	}

	.video-modal-content h2 {
		margin: 0 3rem 1rem 0;
	}


	/* Botón cerrar */

	.close-video {
		position: absolute;

		top: 12px;
		right: 15px;

		width: 42px;
		height: 42px;

		border: none;
		border-radius: 50%;

		background: rgba(var(--gray-light), 0.7);

		color: rgb(var(--black));

		font-size: 1.8rem;
		line-height: 1;

		cursor: pointer;
	}

	.close-video:hover {
		background: rgba(var(--gray), 0.3);
	}


	/* Video */

	.video-container {
		width: 100%;
		aspect-ratio: 16 / 9;

		background: black;

		border-radius: 12px;

		overflow: hidden;
	}

	.video-container video {
		width: 100%;
		height: 100%;

		display: block;

		object-fit: contain;

		background: black;
	}


	/* =========================
	   CELULARES
	   ========================= */

	@media (max-width: 720px) {

		.hero {
			padding: 2rem 0;
		}

		.avatar {
			width: 150px;
			height: 150px;
		}

		.hero h1 {
			font-size: 2.2rem;
		}

		.hero p {
			font-size: 1rem;
		}

		.video-banner {
			height: 190px;
		}

		.play-icon {
			width: 65px;
			height: 65px;
			font-size: 1.6rem;
		}

		.video-info {
			padding: 1.2rem;
		}

		.video-info h2 {
			font-size: 1.25rem;
		}

		.video-modal {
			padding: 0.8rem;
		}

		.video-modal-content {
			padding: 1rem;
		}
	}

</style>


<script>

	const openButton =
		document.getElementById('open-video');

	const closeButton =
		document.getElementById('close-video');

	const modal =
		document.getElementById('video-modal');

	const backdrop =
		document.getElementById('video-backdrop');

	const video =
		document.getElementById('presentation-video') as HTMLVideoElement | null;


	function openVideo() {

		if (!modal) return;

		modal.classList.add('open');

		modal.setAttribute(
			'aria-hidden',
			'false'
		);

		document.body.style.overflow = 'hidden';
	}


	function closeVideo() {

		if (!modal) return;

		modal.classList.remove('open');

		modal.setAttribute(
			'aria-hidden',
			'true'
		);

		document.body.style.overflow = '';

		if (video) {
			video.pause();
		}
	}


	openButton?.addEventListener(
		'click',
		openVideo
	);

	closeButton?.addEventListener(
		'click',
		closeVideo
	);

	backdrop?.addEventListener(
		'click',
		closeVideo
	);


	document.addEventListener(
		'keydown',
		(event) => {

			if (event.key === 'Escape') {
				closeVideo();
			}

		}
	);

</script>